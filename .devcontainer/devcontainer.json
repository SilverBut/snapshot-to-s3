{
  "name": "snapshot-to-s3 Development Container",
  "image": "mcr.microsoft.com/devcontainers/rust:2-1-trixie",
  "runArgs": [
    // "--platform=linux/amd64",
    // "--userns=keep-id",
    "--device=/dev/zfs"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "fill-labs.dependi",
        "vadimcn.vscode-lldb",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },
  // "mounts": [
  //   "source=/dev/zfs,target=/dev/zfs,type=device"
  // ],
  "capAdd": [
    "SYS_ADMIN"
  ],
  "securityOpt": [
    "apparmor=unconfined",
    "label=disable"
  ],
  // "features": {
  //   "ghcr.io/devcontainers/features/github-cli:1": {}
  // },
  "postCreateCommand": {
    "version check": "rustc --version && cargo --version",
    "install zfs by host zfs version 2.4.4-1": "sudo DEBIAN_FRONTEND=noninteractive sh .devcontainer/install_zfs.sh"
  },
  // "remoteUser": "vscode",
  // "workspaceMount": "type=bind,source=${localWorkspaceFolder}/,target=/workspaces/snapshot-to-s3,idmap=uids=501-1000-1;gids=20-1000-1"
}