{
  "name": "snapshot-to-s3 Development Container",
  "image": "mcr.microsoft.com/devcontainers/rust:2-1-trixie",
  "runArgs": [
    // "--platform=linux/amd64",
    // "--userns=keep-id",
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "fill-labs.dependi",
        "vadimcn.vscode-lldb",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },
  // "features": {
  //   "ghcr.io/devcontainers/features/github-cli:1": {}
  // },
  "postCreateCommand": "rustc --version && cargo --version",
  // "remoteUser": "vscode",
  // "workspaceMount": "type=bind,source=${localWorkspaceFolder}/,target=/workspaces/snapshot-to-s3,idmap=uids=501-1000-1;gids=20-1000-1"
}